# Copy to .env and fill in. NEVER commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# Public HTTPS origin of the deployed app. In production this is your domain,
# e.g. https://litewrite.example.com — it becomes the OAuth client_id base.
# The confidential OAuth client requires the client_id to be an HTTPS URL with a
# non-IP hostname, so for local OAuth testing you need a tunnel (e.g. ngrok /
# cloudflared) and must set PUBLIC_URL to that HTTPS URL. A bare http://127.0.0.1
# origin only works for the non-OAuth paths (health, static). See FRICTION.md.
PUBLIC_URL=https://your-tunnel-subdomain.example.com

# Postgres. Heroku sets DATABASE_URL automatically for the Postgres add-on.
# Locally, point at your own instance:
DATABASE_URL=postgres://litewrite:litewrite@127.0.0.1:5432/litewrite
# Require TLS for the DB connection. Off locally, on for Heroku Postgres.
DATABASE_SSL=false

# --- OAuth (M1) ---------------------------------------------------------------
# Generate PRIVATE_JWK and COOKIE_SECRET with:  npm run keygen
# Then paste the two lines it prints here (or set them as Heroku config vars).

# Name shown on the consent screen.
CLIENT_NAME=litewrite

# Granular OAuth scope: base atproto access + write to our one record collection.
OAUTH_SCOPE=atproto repo:com.michielbdejong.litewrite.note

# Confidential-client signing key, a private EC P-256 JWK (JSON on one line).
# The public half is published at /jwks.json. NEVER commit the real value.
PRIVATE_JWK='{"kty":"EC","crv":"P-256","x":"…","y":"…","d":"…","kid":"litewrite-signing-key","alg":"ES256"}'

# Secret used to encrypt the browser session cookie (>= 32 chars).
COOKIE_SECRET=change-me-to-a-long-random-string-min-32-chars
