{
  "name": "litewrite-atproto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A distraction-free notes editor whose notes live in the user's own AT Protocol repository.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "npm -w web run dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm -w web run build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "keygen": "node scripts/generate-keys.mjs",
    "lexgen": "lex build --lexicons ./lexicons --out ./src/lexicon --clear",
    "test:unit": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm -w web run typecheck",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@atproto/api": "^0.20.41",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lex": "^0.3.6",
    "@atproto/oauth-client-node": "^0.5.3",
    "express": "^4.21.2",
    "iron-session": "^8.0.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.10.10",
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
